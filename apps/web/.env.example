# ==============================================================================
# ZENITH Web Client Application Environment Variables
# ==============================================================================

# Application Environment (development, staging, production)
VITE_APP_ENV=production
VITE_APP_NAME="ZENITH"
VITE_APP_URL="https://app.zenith.exchange"

# WalletConnect / Reown Project ID
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Alchemy / Infura API Keys for multi-chain RPC fallbacks
VITE_ALCHEMY_API_KEY=your_alchemy_api_key
VITE_INFURA_API_KEY=your_infura_api_key

# Solana RPC Endpoint
VITE_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Deployed Contract Addresses (Mainnet)
VITE_ZENITH_ROUTER_ETHEREUM="0x0000000000000000000000000000000000000000"
VITE_ZENITH_ROUTER_ARBITRUM="0x0000000000000000000000000000000000000000"
VITE_ZENITH_ROUTER_BASE="0x0000000000000000000000000000000000000000"

# Optional MEV Flashbots Relay Endpoint
VITE_FLASHBOTS_RELAY_URL="https://relay.flashbots.net"
