# ==============================================================================
# ZENITH Smart Contract Deployment Environment Variables
# ==============================================================================

# Private key of the deployer account (0x-prefixed or hex string)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC Endpoint for target network
RPC_URL=https://eth.llamarpc.com

# Target Etherscan / Block Explorer API key for automated verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Protocol Governance (Safe 4-of-7 Multisig Address)
GOVERNANCE_MULTISIG=0x1111111111111111111111111111111111111111

# Emergency Guardian Address (Circuit Breaker Pauser)
EMERGENCY_GUARDIAN=0x2222222222222222222222222222222222222222

# Protocol Treasury Address (Fee Collector)
TREASURY_ADDRESS=0x3333333333333333333333333333333333333333

# Default Swap Fee in Basis Points (5 BPS = 0.05%, Max = 30 BPS)
DEFAULT_FEE_BPS=5
